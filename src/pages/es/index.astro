---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { Image } from "astro:assets";
import profilePhoto from "@/assets/images/ProfilePic.png";

const { features, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const targetLocale = locale === "en" ? "es" : "en";
const targetPath = getRelativeLocaleUrl(targetLocale, "");
const enPath = getRelativeLocaleUrl("en", "");
const esPath = getRelativeLocaleUrl("es", "");

const posts = await getCollection("posts", ({ id }) => id.startsWith(`${locale}/`));
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="theme-toggle"
      class="fixed top-4 right-4 z-50 flex items-center justify-center gap-3"
    >
      <a
        id="lang-toggle"
        href={targetPath}
        class="hover:text-accent font-semibold uppercase transition-colors"
      >
        {locale}
      </a>
      {
        features.lightAndDarkMode && (
          <div class="flex items-center">
            <button
              id="theme-btn"
              class="focus-outline hover:[&>svg]:stroke-accent relative size-12 p-4 sm:size-8"
              title={t.a11y.toggleTheme}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          </div>
        )
      }
    </section>
    <section
      id="hero"
      class="flex min-h-screen flex-col items-center justify-center px-4 py-12 text-center"
    >
      <Image
        src={profilePhoto}
        alt="Felipe A. Risso"
        width={277}
        height={319}
        class="mb-4 h-auto w-8 rounded-2xl sm:w-45"
      />
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Felipe A. Risso
      </h1>

      <p>
        Estudiante de Ingeniería Electrónica | Apasionado por la Ciberseguridad
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<script define:vars={{ locale, targetLocale, enPath, esPath }}>
  document.addEventListener("astro:page-load", () => {
    const STORAGE_KEY = "preferredLocale";

    const stored = localStorage.getItem(STORAGE_KEY);
    if (!stored) {
      const browserLang = (navigator.language || "en")
        .slice(0, 2)
        .toLowerCase();
      const preferred = browserLang === "es" ? "es" : "en";

      if (preferred !== locale) {
        localStorage.setItem(STORAGE_KEY, preferred);
        window.location.replace(preferred === "es" ? esPath : enPath);
        return;
      }
    }

    document.getElementById("lang-toggle")?.addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, targetLocale);
    });
  });
</script>
