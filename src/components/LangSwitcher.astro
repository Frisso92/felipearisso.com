---
// src/components/LangSwitcher.astro
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locales?: string[];
  class?: string;
}

const { locales = ['es', 'en'], class: className = '' } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'es';
const { pathname } = Astro.url;

// Elimina el prefijo del idioma actual manteniendo la ruta relativa
const localePrefixRegex = new RegExp(`^/${currentLocale}(/|$)`);
const unlocalizedPath = pathname.replace(localePrefixRegex, '/');

// Calcula el siguiente idioma en la lista
const currentIndex = locales.indexOf(currentLocale);
const nextIndex = currentIndex === -1 ? 0 : (currentIndex + 1) % locales.length;
const nextLocale = locales[nextIndex];

const targetUrl = getRelativeLocaleUrl(nextLocale, unlocalizedPath);
---

<a
  href={targetUrl}
  class:list={[
    "focus-outline hover:text-accent flex items-center justify-center text-1xl font-semibold uppercase transition-colors p-1 sm:p-1",
    className
  ]}
  aria-label={`Switch to ${currentLocale.toUpperCase()}`}
  title={`Switch to ${currentLocale.toUpperCase()}`}
>
  {currentLocale.toUpperCase()}
</a>